# MoneyOS environment — copy to .env and fill in (NEVER commit .env)

# Supabase project (placeholders until the human wires keys — hive card H1)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 1 = demo mode: localStorage repository, auth bypassed, visible demo banner.
# 0 + Supabase keys filled in = live mode (Supabase repository + Google sign-in).
# Without Supabase keys the app stays in demo automatically.
VITE_DEMO_MODE=1
